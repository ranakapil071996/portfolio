NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/billing
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=billing_sid
OTP_STATIC_CODE=0000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SECONDS=600
OTP_REQUEST_MAX=3
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080
